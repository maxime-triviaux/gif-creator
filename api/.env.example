# Copier en api/.env puis adapter. Ce fichier n'est pas versionné.

# Une clé par personne, envoyée dans l'en-tête X-API-Key : nom:clé, séparées par des virgules.
# Générer une clé : openssl rand -hex 24
API_KEYS=alice:remplace-moi-par-une-vraie-cle,bob:remplace-moi-aussi-par-une-cle

# Dossiers de la machine hôte, montés en lecture seule dans le conteneur
HOST_DB_DIR=/srv/kaamelott/db          # contient kaamelott.db
HOST_MEDIA_DIR=/srv/kaamelott/medias   # équivalent de data/ : contient Kaamelott/S01, S02…

# Domaine servi par Traefik (avec docker-compose.traefik.yml uniquement)
API_DOMAIN=gif.ml-sirh.fr

# Port direct, sans Traefik. 127.0.0.1 : accessible seulement depuis la machine.
# 0.0.0.0 : exposé sur Internet, en HTTP clair.
BIND=127.0.0.1
PORT=8000

CACHE_MAX_MO=2000   # taille maximale du cache de GIF
MAX_FFMPEG=2        # générations simultanées
