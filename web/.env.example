# Copier en web/.env pour un déploiement manuel. Ce fichier n'est pas versionné.
# Aucune clé ici : chacun saisit la sienne dans l'app, sur son téléphone.

# Le domaine de l'API : l'app est servie sous https://API_DOMAIN/app/
API_DOMAIN=gif.ml-sirh.fr

# Port direct, sans Traefik. 127.0.0.1 : accessible seulement depuis la machine.
BIND=127.0.0.1
PORT=8080
